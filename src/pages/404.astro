---
import Base from '../layouts/Base.astro'
---
<Base title="Página no encontrada · tapy." noindex>
  <main class="min-h-screen flex flex-col items-center justify-center gap-4 px-6 text-center">
    <img src="/logo/tapy-horizontal-color.png" alt="tapy." class="h-10" />
    <h1 class="text-2xl font-bold text-gray-900">Página no encontrada</h1>
    <p class="text-gray-600 m-0">La página que buscas no existe o cambió de lugar.</p>
    <a href="/" class="btn btn-rounded btn-contrast font-bold">Ir al inicio</a>
  </main>
</Base>

---
import '../styles/global.css'
// After Tailwind, as on the Nuxt site: `.pi { line-height: 1 }` must beat text-lg & co.
import 'primeicons/primeicons.css'
import Gtag from '../components/Gtag.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
  title: string
  description?: string
  keywords?: string
  /** Defaults to title / description. */
  ogTitle?: string
  ogDescription?: string
  twitterTitle?: string
  twitterDescription?: string
  /** Path without locale prefix, e.g. `/contact-us`. Set only for pages that exist in both locales. */
  alternatePath?: string
  noindex?: boolean
  gtag?: boolean
}

const {
  locale = 'es',
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription = description,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  alternatePath,
  noindex = false,
  gtag = false,
} = Astro.props

const site = 'https://tapy.mx'
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = `${site}/logo/tapy-horizontal-color.png`
---
<!doctype html>
<html lang={locale === 'es' ? 'es-MX' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternatePath && (
      <>
        <link rel="alternate" hreflang="es-MX" href={new URL(localePath('es', alternatePath), site).href} />
        <link rel="alternate" hreflang="en" href={new URL(localePath('en', alternatePath), site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(alternatePath, site).href} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/branding/favicon.svg" />
    <link rel="icon" type="image/png" href="/branding/favicon.png" />
    <link rel="apple-touch-icon" href="/branding/icon.png" />
    <meta name="theme-color" content="#10b981" />
    <meta property="og:title" content={ogTitle} />
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
    <meta name="twitter:image" content={ogImage} />
    {gtag && <Gtag />}
  </head>
  <body>
    <slot />
  </body>
</html>

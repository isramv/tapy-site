# App routes moved to app.tapy.mx with the marketing/app split. Old links,
# bookmarks and emails keep working.
/app/*          https://app.tapy.mx/app/:splat          301
/store/*        https://app.tapy.mx/store/:splat        301
/auth/*         https://app.tapy.mx/auth/:splat         301
/super-admin/*  https://app.tapy.mx/super-admin/:splat  301
/oauth/*        https://app.tapy.mx/oauth/:splat        301
/paused         https://app.tapy.mx/paused              301
/unauthorized   https://app.tapy.mx/unauthorized        301

# Old Nuxt URLs Google still has: trailing slashes and the old sitemap. 301 so the
# clean URL replaces them (the asset layer's own slash redirect is a 307).
